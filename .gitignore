# ============================================
# 吟心项目 .gitignore
# ============================================

# ============================================
# 环境变量和敏感信息（重要！）
# ============================================
.env
.env.local
.env.*.local
backend/.env
frontend/.env
*.env
!.env.example

# ============================================
# Node.js 依赖和构建产物
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 构建输出
dist/
build/
*.tsbuildinfo

# 前端构建产物
frontend/dist/
frontend/build/
frontend/.vite/

# 后端构建产物
backend/dist/
backend/build/

# ============================================
# 数据库文件
# ============================================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# ============================================
# 数据目录（用户数据、索引数据等）
# ============================================
# MeiliSearch 数据
data.ms/

# 用户数据目录
data/poetry.json
data/poetry.ndjson
!data/.gitkeep

# 数据转储目录
dumps/

# 旧数据目录
old-data/

# 用户头像（如果不想提交到仓库）
# data/avatar/
# frontend/public/avatar/
# frontend/dist/avatar/

# ============================================
# 可执行文件和二进制文件
# ============================================
*.exe
*.bin
meilisearch.exe
meilisearch

# ============================================
# 日志文件
# ============================================
*.log
logs/
*.log.*

# ============================================
# 操作系统文件
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.Trash-*

# ============================================
# IDE 和编辑器
# ============================================
# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ IDEA / WebStorm
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# ============================================
# 临时文件和缓存
# ============================================
*.tmp
*.temp
*.cache
.cache/
.temp/
tmp/
temp/

# ============================================
# 备份文件
# ============================================
*.bak
*.backup
*.old
*.orig
*.save

# ============================================
# Docker 相关（可选，根据需要取消注释）
# ============================================
# .docker/
# docker-compose.override.yml

# ============================================
# 测试覆盖率
# ============================================
coverage/
*.lcov
.nyc_output/

# ============================================
# 其他
# ============================================
# 包管理器锁文件（如果团队统一使用，可以保留）
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# 大型 JSON 数据文件（如果不想提交）
# latest.json
# data/*.json
# data/*.ndjson

# PM2 进程管理
.pm2/
ecosystem.config.js

# ============================================
# 保留文件（使用 ! 来保留某些文件）
# ============================================
# 保留示例文件
!backend/env.example
!frontend/env.example

# 保留必要的配置文件
!package.json
!package-lock.json
